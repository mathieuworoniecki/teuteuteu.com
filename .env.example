# Public project URL used only by server-side Supabase access.
SUPABASE_URL=
NEXT_PUBLIC_SITE_URL=https://teuteuteu.com
# Server-only. Prefer the modern sb_secret_ key. Never expose it through NEXT_PUBLIC_ variables.
SUPABASE_SECRET_KEY=
# Legacy fallback, supported for Vercel integrations that still use this name.
SUPABASE_SERVICE_ROLE_KEY=

# Buy Me a Coffee > Integrations > webhook signing secret.
BUY_ME_A_COFFEE_WEBHOOK_SECRET=

# Long random value used only to hash IPs for the click burst limit.
CLICK_RATE_LIMIT_SECRET=
# Emergency switch: set to false to keep the site live while disabling counter writes.
CLICK_COUNTER_ENABLED=true
